    ./lx install                        habilitar o comando 'lx' global
    lx setup                            (depois disso, de qualquer pasta)
    ./lx start                          iniciar (GPU automática)
    ./lx start --gpu software           iniciar sem GPU (diagnóstico)
    ./lx start --extra "-force-bgra"    corrigir cores invertidas
    ./lx dev termux                     só o ambiente dev do Termux

${C_BOLD}DOCUMENTAÇÃO${C_RESET}
    docs/01-pre-requisitos.md     apps e opções do Android (leia primeiro)
    docs/06-monitor-externo.md    usar num monitor via hub USB-C
    docs/07-aceleracao-gpu.md     detalhes e diagnóstico de GPU
    ${REPO_URL}
EOF
}

# ===========================================================================
#  Dispatch
# ===========================================================================

main() {
    state_init

    local cmd="${1:-}"
    [ $# -gt 0 ] && shift

    case "$cmd" in
        ""|menu)          cmd_menu ;;
        setup)            cmd_setup ;;
        start|iniciar)    cmd_start "$@" ;;
        stop|parar)       cmd_stop ;;
        dev)              cmd_dev "$@" ;;
        gpu)              cmd_gpu ;;
        doctor|diag)      cmd_doctor ;;
        status)           cmd_status ;;
        shell|ubuntu)     cmd_shell ;;
        update)           cmd_update ;;
        install)          cmd_install ;;
        uninstall)        cmd_uninstall ;;
        help|-h|--help)   cmd_help ;;
        version|--version|where)
            say "lx v${LX_VERSION}"
            say "arquivo:  $(self_path)"
            say "invocado: ${BASH_SOURCE[0]}"
            say "contexto: ${CTX}"
            ;;

        # Subcomandos internos, usados quando o script se re-invoca no Ubuntu.
        setup-kde)        install_kde_inside ;;
        setup-gpu)        install_gpu_inside ;;

        *) err "comando desconhecido: '$cmd'"; echo; cmd_help; exit 1 ;;
    esac
}

main "$@"
