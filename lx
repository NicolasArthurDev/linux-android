cmd_menu() {
    while true; do
        clear 2>/dev/null || true
        printf '%s\n' "$C_BOLD$C_CYN"
        cat <<'BANNER'
    _
  | |_  __
  | | \/  |   linux-android
  |_|_/\__|   Linux com KDE no Android
BANNER
        printf '%s' "$C_RESET"
        say "  v${LX_VERSION} · contexto: ${CTX}"
        echo

        local -a done_marks=()
        local k
        for k in termux ubuntu kde gpu dev-termux dev-ubuntu; do
            state_has "$k" && done_marks+=("$k")
        done
        info "concluído: ${#done_marks[@]}/6 etapas  (veja em 'status')"
        echo
        say "  ${C_BOLD}1${C_RESET})  Instalar tudo            (setup)"
        say "  ${C_BOLD}2${C_RESET})  Iniciar o desktop        (start)"
        say "  ${C_BOLD}3${C_RESET})  Parar o desktop          (stop)"
        say "  ${C_BOLD}4${C_RESET})  Ambiente de dev          (dev)"
        say "  ${C_BOLD}5${C_RESET})  Ativar GPU               (gpu)"
        say "  ${C_BOLD}6${C_RESET})  Diagnóstico              (doctor)"
        say "  ${C_BOLD}7${C_RESET})  Status                   (status)"
        say "  ${C_BOLD}8${C_RESET})  Terminal do Ubuntu       (shell)"
        say "  ${C_BOLD}9${C_RESET})  Atualizar                (update)"
        if have lx; then
            say "  ${C_DIM}i)  comando 'lx' já instalado${C_RESET}"
        else
            say "  ${C_BOLD}i${C_RESET})  Usar 'lx' de qualquer pasta  (install)"
        fi
        say "  ${C_BOLD}0${C_RESET})  Sair"
        echo
        printf '%sEscolha:%s ' "$C_BOLD" "$C_RESET"
        local choice; read -r choice

        case "$choice" in
            1) cmd_setup ;;
            2) cmd_start ;;
            3) cmd_stop ;;
            4) menu_dev ;;
            5) cmd_gpu ;;
            6) cmd_doctor ;;
            7) cmd_status ;;
            8) cmd_shell ;;
            9) cmd_update ;;
            i|I) cmd_install ;;
            0|q|Q) exit 0 ;;
            *) warn "opção inválida" ;;
        esac

        echo
        printf '%sEnter para voltar ao menu...%s' "$C_DIM" "$C_RESET"
        read -r _
    done
}

menu_dev() {
    header "Ambiente de desenvolvimento"
    say "  Instala: zsh + oh-my-zsh (darkblood), NvChad, tmux, git,"
    say "           btop, bat, fzf, lazygit, fastfetch e Claude Code."
    echo
    say "  ${C_BOLD}1${C_RESET})  Nos dois (Termux + Ubuntu)   ${C_DIM}recomendado${C_RESET}"
    say "  ${C_BOLD}2${C_RESET})  Só no Termux"
    say "  ${C_BOLD}3${C_RESET})  Só no Ubuntu"
    say "  ${C_BOLD}0${C_RESET})  Voltar"
    echo
    printf '%sEscolha:%s ' "$C_BOLD" "$C_RESET"
    local c; read -r c
    case "$c" in
        1) cmd_dev both ;;
        2) cmd_dev termux ;;
        3) cmd_dev ubuntu ;;
        *) return 0 ;;
    esac
}

