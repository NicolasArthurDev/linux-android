#  Rice — bspwm + Catppuccin Mocha
# ===========================================================================
#
#  Escolha de componentes, e por que:
#
#    bspwm + sxhkd  tiling por arvore, tudo controlavel via 'bspc'
#    polybar        barra. (Waybar NAO serve: e Wayland-only, e aqui o
#                   Termux:X11 e um servidor X)
#    rofi           launcher
#    picom          cantos arredondados + transparencia
#    kitty          terminal acelerado por GPU — faz sentido com a Adreno ativa
#    dunst          notificacoes
#
#  Sobre o visual: cantos arredondados + gaps largos + transparencia simples
#  dao o resultado minimalista tipo Hyprland SEM blur. Blur e o efeito mais
#  caro de todos e derruba o desempenho em proot; tudo o mais e barato.
#
#  Hyprland nao e opcao: e Wayland puro. Rodar aninhado exigiria wlroots
#  compilado com backend X11, que os pacotes de distro nao trazem.

CATPPUCCIN_ROSEWATER="#f5e0dc"; CATPPUCCIN_MAUVE="#cba6f7"
CATPPUCCIN_BASE="#1e1e2e";      CATPPUCCIN_SURFACE="#313244"
CATPPUCCIN_TEXT="#cdd6f4";      CATPPUCCIN_BLUE="#89b4fa"

install_nerd_font_inside() {
    step "Fonte JetBrainsMono Nerd Font"
    if fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd"; then
        ok "já instalada"; return 0
    fi
    # A 'fonts-jetbrains-mono' do apt NAO tem os glifos de icone que a polybar
    # usa — precisa da versao "patched" do projeto nerd-fonts.
    local url tmp
    url="$(gh_latest_asset ryanoasis/nerd-fonts 'JetBrainsMono\.tar\.xz')"
    [ -n "$url" ] || { warn "não achei o release da Nerd Font"; return 1; }
    tmp="$(mktemp -d /tmp/nf-XXXXXX)"
    if fetch "$url" "$tmp/f.tar.xz"; then
        mkdir -p /usr/local/share/fonts/JetBrainsMonoNerd
        tar -xJf "$tmp/f.tar.xz" -C /usr/local/share/fonts/JetBrainsMonoNerd 2>/dev/null
        fc-cache -f >/dev/null 2>&1
        ok "instalada"
    else
        warn "download da fonte falhou"
    fi
    rm -rf "$tmp"
}

