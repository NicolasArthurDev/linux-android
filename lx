# ===========================================================================
#  Ajuda
# ===========================================================================

cmd_help() {
    cat <<EOF
${C_BOLD}lx${C_RESET} v${LX_VERSION} — gerenciador do projeto linux-android

${C_BOLD}USO${C_RESET}
    ./lx                    menu interativo
    ./lx <comando> [opções]

${C_BOLD}COMANDOS${C_RESET}
    ${C_BOLD}setup${C_RESET}               Instala tudo: Termux, Ubuntu, KDE e GPU.
                        Pula o que já está feito — pode rodar de novo.

    ${C_BOLD}start${C_RESET} [opções]      Inicia o desktop.
        --de AMBIENTE     kde (padrão) | bspwm | xfce
        --gpu MODO        auto (padrão) | turnip | virgl | software
        --alt             método alternativo (-xstartup), se o normal falhar
        --extra "FLAGS"   flags do termux-x11:
                            -legacy-drawing   tela preta
                            -force-bgra       cores trocadas
                            -dpi 96           ajuste de tamanho do texto

    ${C_BOLD}stop${C_RESET}                Encerra o desktop e libera memória.

    ${C_BOLD}dev${C_RESET} [alvo]          Ambiente de desenvolvimento.
                        alvo: both (padrão) | termux | ubuntu
        --no-claude       não instalar o Claude Code

                        Instala: zsh + oh-my-zsh (tema darkblood), NvChad,
                        tmux, git, btop, bat, fzf, lazygit, fastfetch e
                        Claude Code.

                        O Claude Code é instalado DENTRO do Ubuntu, com o
                        instalador oficial do npm. No Termux nativo ele não
                        roda: é um binário linkado com glibc e o Android usa
                        bionic libc. O comando 'claude' fica disponível no
                        Termux por um wrapper que executa no Ubuntu.

    ${C_BOLD}gpu${C_RESET}                 Ativa a aceleração de GPU (Turnip/Adreno).

    ${C_BOLD}rice${C_RESET}                Instala um desktop "rice": bspwm + sxhkd, polybar,
                        rofi, picom (cantos arredondados e transparência),
                        kitty, dunst e a fonte JetBrainsMono Nerd, tudo com
                        a paleta Catppuccin Mocha.
                        Depois:  lx start --de bspwm

    ${C_BOLD}browser${C_RESET} [qual]      Instala um navegador que REALMENTE roda em proot.
                        qual: firefox (padrão) | falkon

                        O 'firefox'/'chromium' do Ubuntu são pacotes de
                        transição para snap, e snap não funciona em proot.
                        Este comando usa o repositório .deb oficial da
                        Mozilla e desativa o sandbox, que precisa de
                        namespaces indisponíveis aqui.

    ${C_BOLD}doctor${C_RESET}              Diagnostica o que está faltando ou errado.
    ${C_BOLD}status${C_RESET}              Mostra quais etapas já foram concluídas.
    ${C_BOLD}shell${C_RESET}               Abre um terminal dentro do Ubuntu.
    ${C_BOLD}update${C_RESET}              Atualiza o repositório e os pacotes dos dois ambientes.
    ${C_BOLD}clean${C_RESET}               Libera espaço: caches de pacotes e camadas OCI baixadas.

    ${C_BOLD}install${C_RESET}             Deixa o 'lx' disponível de qualquer pasta.
                        Cria um symlink em \$PREFIX/bin (não é um alias: também
                        funciona dentro de scripts, subshells e outros shells).
                        Como é symlink, 'git pull' já atualiza o comando.
    ${C_BOLD}uninstall${C_RESET}           Remove esse atalho (o repositório fica).

    ${C_BOLD}help${C_RESET}                Esta ajuda.

${C_BOLD}EXEMPLOS${C_RESET}
    ./lx install                        habilitar o comando 'lx' global
    lx setup                            (depois disso, de qualquer pasta)
    ./lx start                          iniciar (GPU automática)
    ./lx start --gpu software           iniciar sem GPU (diagnóstico)
    ./lx start --extra "-force-bgra"    corrigir cores invertidas
    ./lx dev termux                     só o ambiente dev do Termux

${C_BOLD}DOCUMENTAÇÃO${C_RESET}
    docs/01-pre-requisitos.md     apps e opções do Android (leia primeiro)
    docs/06-monitor-externo.md    usar num monitor via hub USB-C
    docs/07-aceleracao-gpu.md     detalhes e diagnóstico de GPU
    ${REPO_URL}
EOF
}

# ===========================================================================
#  Dispatch
# ===========================================================================

main() {
    state_init

    local cmd="${1:-}"
    [ $# -gt 0 ] && shift

    case "$cmd" in
        ""|menu)          cmd_menu ;;
        setup)            cmd_setup ;;
        start|iniciar)    cmd_start "$@" ;;
        stop|parar)       cmd_stop ;;
        dev)              cmd_dev "$@" ;;
        gpu)              cmd_gpu ;;
        browser|navegador) cmd_browser "$@" ;;
        rice)             cmd_rice ;;
        doctor|diag)      cmd_doctor ;;
        status)           cmd_status ;;
        shell|ubuntu)     cmd_shell ;;
        update)           cmd_update ;;
        clean|limpar)     cmd_clean ;;
        install)          cmd_install ;;
        uninstall)        cmd_uninstall ;;
        help|-h|--help)   cmd_help ;;
        version|--version|where)
            say "lx v${LX_VERSION}"
            say "arquivo:  $(self_path)"
            say "invocado: ${BASH_SOURCE[0]}"
            say "contexto: ${CTX}"
            ;;

        # Subcomandos internos, usados quando o script se re-invoca no Ubuntu.
        setup-kde)        install_kde_inside ;;
        setup-gpu)        install_gpu_inside ;;
        browser-install)  install_browser_inside "$@" ;;
        rice-install)     install_rice_inside ;;

        *) err "comando desconhecido: '$cmd'"; echo; cmd_help; exit 1 ;;
    esac
}

main "$@"
