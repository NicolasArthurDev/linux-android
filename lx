setup_ohmyzsh() {
    local home="$1"
    step "Oh My Zsh + tema darkblood"

    if [ -d "$home/.oh-my-zsh" ]; then
        ok "Oh My Zsh já instalado"
    else
        RUNZSH=no CHSH=no KEEP_ZSHRC=no \
            sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
            "" --unattended || { warn "falha ao instalar o Oh My Zsh"; return 1; }
    fi

    # darkblood é um tema que já vem com o Oh My Zsh — não precisa baixar nada.
    if [ -f "$home/.zshrc" ]; then
        sed -i 's/^ZSH_THEME=.*/ZSH_THEME="darkblood"/' "$home/.zshrc"
        grep -q '^ZSH_THEME=' "$home/.zshrc" || echo 'ZSH_THEME="darkblood"' >> "$home/.zshrc"
        ok "tema darkblood configurado"
    fi
}

append_shell_rc() {
    # Acrescenta um bloco idempotente aos rc do bash e do zsh.
    local home="$1" marker="# >>> lx dev >>>" body="$2" f
    for f in "$home/.zshrc" "$home/.bashrc"; do
        [ -f "$f" ] || continue
        grep -qF "$marker" "$f" && continue
        {
            echo ""
            echo "$marker"
            echo "$body"
            echo "# <<< lx dev <<<"
        } >> "$f"
    done
}

setup_nvchad() {
    local home="$1"
    step "NvChad (configuração do Neovim)"

    if [ -d "$home/.config/nvim" ]; then
        if [ -d "$home/.config/nvim/lua/chadrc.lua" ] || [ -f "$home/.config/nvim/lua/chadrc.lua" ]; then
            ok "NvChad já instalado"; return 0
        fi
        local bak="$home/.config/nvim.bak.$$"
        warn "já existe uma config do Neovim — movendo para $bak"
        mv "$home/.config/nvim" "$bak"
    fi

    mkdir -p "$home/.config"
    git clone -q --depth 1 https://github.com/NvChad/starter "$home/.config/nvim" \
        || { warn "falha ao clonar o NvChad"; return 1; }
    rm -rf "$home/.config/nvim/.git"
    ok "NvChad instalado — na primeira execução do 'nvim' ele baixa os plugins"
}

dev_termux() {
    require_termux "dev"
    header "Ambiente de desenvolvimento — Termux"

    step "Instalando pacotes"
    # Estes existem todos nos repositórios do Termux.
    pkg install -y \
        zsh git tmux btop bat fzf lazygit \
        neovim nodejs ripgrep fd \
        clang make python openssh \
        || warn "algum pacote falhou (seguindo)"

    # fastfetch substitui o neofetch, que está descontinuado desde 2024.
    if pkg install -y fastfetch 2>/dev/null; then
        ok "fastfetch instalado"
    else
        pkg install -y neofetch 2>/dev/null && ok "neofetch instalado" \
            || warn "nem fastfetch nem neofetch disponíveis"
    fi

    setup_ohmyzsh "$HOME"
    setup_nvchad  "$HOME"

    step "Aliases e configurações"
    append_shell_rc "$HOME" '
# bat: no Termux o binário já se chama "bat"
alias cat="bat --paging=never"
alias ls="ls --color=auto"
alias ll="ls -lah"
alias lg="lazygit"
alias vim="nvim"
alias v="nvim"

# fzf
[ -f "$PREFIX/share/fzf/key-bindings.zsh" ] && source "$PREFIX/share/fzf/key-bindings.zsh" 2>/dev/null
[ -f "$PREFIX/share/fzf/completion.zsh" ]   && source "$PREFIX/share/fzf/completion.zsh"   2>/dev/null

# claude: roda dentro do Ubuntu (glibc), ver "lx dev"
'

    setup_tmux_conf "$HOME"
    [ -n "${LX_NO_CLAUDE:-}" ] || install_claude_wrapper

    step "Shell padrão"
    if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
        if chsh -s zsh 2>/dev/null; then ok "zsh definido como shell padrão"
        else info "não consegui trocar o shell — rode manualmente: chsh -s zsh"; fi
    else
        ok "zsh já é o shell padrão"
    fi

    state_set dev-termux
    echo
    ok "Ambiente dev do Termux pronto. Abra um novo terminal para carregar o zsh."
}

